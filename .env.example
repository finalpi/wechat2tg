BOT_TOKEN=
# Telegram API配置
API_ID=
API_HASH=
# 登录协议类型：'ipad' | 'car' | 'mac' | 'pad' | 'win' | 'ipadX'
DEVICE_TYPE=ipad
# 消息响应模式：'polling' | 'callback'
MODE=polling
# 如果是 callback 模式需要填写回调端口号
CALLBACK_PORT=8056
# 代理配置(可选)
# 协议socks5,http,https
#PROXY_PROTOCOL=socks5
#PROXY_HOST=
#PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
# 微信 socks 代理配置(如果提示输入验证码可以尝试使用代理，代理到同一个区域)
# WX_PROXY_HOST=
# WX_PROXY_USERNAME=
# WX_PROXY_PASSWORD=
# 腾讯云ASR配置
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 自定义消息模板配置:(#[alias]:联系人备注,#[name]:联系人昵称,#[topic]:群聊昵称,#[alias_first]:备注优先,如果没有备注就显示联系人的昵称)
## 群消息身份格式
ROOM_MESSAGE_GROUP='<b>👤#[(alias)] #[name]: </b>'
## 公众号消息身份格式
OFFICIAL_MESSAGE_GROUP='<b>📣#[name]: </b>'
## 联系人消息身份格式
CONTACT_MESSAGE_GROUP='<b>👤#[alias_first]: </b>'
## 自动创建微信群组的名称格式
CREATE_ROOM_NAME='#[alias_first]'
## 自动创建联系人群组的名称格式
CREATE_CONTACT_NAME='#[alias]#[[name]]'
## 文字消息显示格式:#[identity]身份文本,#[body]:消息文本,#[br]换行
MESSAGE_DISPLAY='#[identity]#[br]#[body]'
BASE_API='http://wx2tg-server:8058/api'
# 启用自动删除旧消息(仅删除数据库消息，旧消息用于引用回复消息或者撤回消息)
AUTO_DELETE_OLD_MESSAGES=false
# 保留对应时间(天)内的消息
MESSAGE_RETENTION_DAYS=7

# ============ 消息发送重试配置 ============

# 发送到微信的消息最大重试次数
# 0 = 无限重试，直到成功
# 默认值：3
SEND_TO_WX_MAX_RETRIES=3

# 发送到微信的消息超时时间（毫秒）
# 默认值：30000（30秒）
SEND_TO_WX_TIMEOUT=30000

# 发送到 Telegram 的消息最大重试次数
# 0 = 无限重试，直到成功
# 默认值：3
SEND_TO_TG_MAX_RETRIES=3

# 发送到 Telegram 的消息重试延迟基数（毫秒）
# 实际延迟 = 基数 * 2^(重试次数-1)，最大延迟 60 秒
# 默认值：5000（5秒）
SEND_TO_TG_RETRY_DELAY=5000

# 消息缓冲区过期时间（毫秒）
# 超过此时间的消息将被清理（无论是否发送成功）
# 默认值：300000（5分钟）
MESSAGE_BUFFER_EXPIRE_TIME=300000

# ============ AI 回复建议配置 ============

# OpenAI-compatible API Key
AI_API_KEY=

# OpenAI-compatible chat completions URL
# 例如：https://api.openai.com/v1/chat/completions
AI_API_URL=

# 模型名称
AI_MODEL=gpt-4o-mini

# AI 上下文消息条数
AI_CONTEXT_LIMIT=20
