BOT_TOKEN=
# Telegram API配置
API_ID=
API_HASH=
# 登录协议类型：'ipad' | 'car' | 'mac' | 'pad' | 'win' | 'ipadX'
DEVICE_TYPE=ipad
# 消息响应模式：'polling' | 'callback'
# 默认 polling，配套 server 的 syncmessage=false、msgpush=false。
# puppet 6.0.12 已支持带正文 callback；切换时同步配置 server，详见 docs/server-v6.md。
MODE=polling
# 仅 callback 模式监听此端口；同一 Compose 网络无需发布到宿主机
CALLBACK_PORT=8056
# 迁移时设为 false：仅转发已绑定会话，不自动创建新 Telegram 群。
# 不影响 /user、/room 等命令的手动操作。
AUTO_CREATE_GROUPS=true
# 公众号集中到一个私有论坛群，每个公众号独立 Topic；默认关闭，修改后重启。
# 开启后不删除旧群/旧绑定，关闭后恢复原来的独立群路由。
OFFICIAL_ACCOUNT_TOPICS_ENABLED=false
# 通常留空自动创建；仅创建结果不确定时，用已创建的论坛群 ID 恢复（-100...）。
OFFICIAL_ACCOUNT_FORUM_CHAT_ID=
# 微信内置 [微笑] 等使用 WeChatPack 行内自定义表情；普通 Emoji 不变。
# 默认关闭；需机器人创建者 Premium 或符合 Telegram 的 Fragment 资格。
# 开启不代表自动获得权限：auto 参考主人近期更新，权限未知/非会员时回退图片链接。
WECHAT_CUSTOM_EMOJI_ENABLED=false
# auto / compatible / enhanced；/display 可即时设置当前聊天或全局覆盖。
# Bot API 不提供接收方客户端版本；旧客户端可选 compatible。
TELEGRAM_DISPLAY_MODE=auto
# 不使用原生自定义表情时：links = 图片超链接；text = 保留微信文字编码。
TELEGRAM_EMOJI_FALLBACK=links
# 代理配置(可选)
# 协议socks5,http,https
#PROXY_PROTOCOL=socks5
#PROXY_HOST=
#PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
# 微信 socks 代理配置(如果提示输入验证码可以尝试使用代理，代理到同一个区域)
# WX_PROXY_HOST=
# WX_PROXY_USERNAME=
# WX_PROXY_PASSWORD=
# 腾讯云ASR配置
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 消息模板：#[member_name] = 成员自己的群昵称，没有时用微信昵称（不取通讯录备注）。
# #[alias] 联系人备注，#[name] 微信昵称，#[topic] 微信群名称，#[alias_first] 备注优先。
# 未设置、留空或纯空格的消息模板使用下列默认值；正文里的 Emoji 保留。
CONTACT_MESSAGE='<b>#[alias_first]: </b>'
OFFICIAL_MESSAGE='<b>#[name]: </b>'
ROOM_MESSAGE='<b>#[member_name]: </b>'
CONTACT_MESSAGE_GROUP='<b>#[alias_first]: </b>'
OFFICIAL_MESSAGE_GROUP='<b>#[name]: </b>'
ROOM_MESSAGE_GROUP='<b>#[member_name]: </b>'
## 自动创建微信群组的名称格式
CREATE_ROOM_NAME='#[alias_first]'
## 自动创建联系人群组的名称格式
CREATE_CONTACT_NAME='#[alias]#[[name]]'
## 文字消息显示格式:#[identity]身份文本,#[body]:消息文本,#[br]换行
MESSAGE_DISPLAY='#[identity]#[br]#[body]'
BASE_API='http://wx2tg-server:8058/api'
# 可选：仅 server 的 messagestore=postgres 时填写，由 Compose 传入 server 容器。
# 默认 SQLite 无需配置；不要提交真实 DSN/密码。切换 PG 前先备份，详见 docs/server-v6.md。
MESSAGE_STORE_POSTGRES_DSN=
# 启用自动删除旧消息（仅 bot 数据库，不清理 server 归档；用于引用回复或撤回）
AUTO_DELETE_OLD_MESSAGES=false
# 保留对应时间(天)内的消息
MESSAGE_RETENTION_DAYS=7

# ============ 消息发送重试配置 ============

# 发送到微信的消息最大重试次数
# 0 = 无限重试，直到成功
# 默认值：3
SEND_TO_WX_MAX_RETRIES=3

# 发送到微信的消息超时时间（毫秒）
# 默认值：30000（30秒）
SEND_TO_WX_TIMEOUT=30000

# 发送到 Telegram 的普通错误最大重试次数
# 0 = 不限次数；明确的连接前网络失败和 429 不受此上限限制
# 超时/连接重置等结果未知的消息会持久保留，核对后在 WebUI 手动同步
# 默认值：3
SEND_TO_TG_MAX_RETRIES=3

# 发送到 Telegram 的消息重试延迟基数（毫秒）
# 指数退避，最大 5 分钟；Telegram 指定的 retry_after 可能更长
# 默认值：5000（5秒）
SEND_TO_TG_RETRY_DELAY=5000

# 兼容旧配置的已完成转发记录清理时间（毫秒）
# 实际至少保留 7 天用于去重；待发送、失败和结果未知的记录不按时间清除
# 旧默认值：300000；未送达内容保存在 storage/db/telegram-outbox.db
MESSAGE_BUFFER_EXPIRE_TIME=300000

# ============ AI 回复建议配置 ============

# OpenAI-compatible API Key
AI_API_KEY=

# OpenAI-compatible chat completions URL
# 例如：https://api.openai.com/v1/chat/completions
AI_API_URL=

# 模型名称
AI_MODEL=gpt-4o-mini

# AI 上下文消息条数
AI_CONTEXT_LIMIT=20

# ============ WebUI / 中英文配置控制台 ============
# 默认随应用启动；设为 false 关闭 / Enabled by default; set false to disable
WEBUI_ENABLED=true
# 本地运行默认 loopback；Docker Compose 自动改为 0.0.0.0 / Local listener; Compose overrides it
WEBUI_HOST=127.0.0.1
WEBUI_PORT=17863
# Docker 宿主机默认对外开放；仅本机访问可设 127.0.0.1 / Compose defaults to all host interfaces
WEBUI_BIND_ADDRESS=0.0.0.0
# 可选，至少 16 字符。不填会自动创建 storage/webui-token
# Optional, at least 16 characters. Otherwise generated in storage/webui-token
# WEBUI_TOKEN=
# Optional Telegram Mini App root HTTPS URL; owner-only, same WebUI. Restart after setting.
# 先用 /login 设置主人；仅向主人私聊安装「控制台」菜单，其他用户无法登录。
# WEBUI_MINI_APP_URL=https://wechat.example.com/
# WebUI 配置优先于 .env / Saved settings override .env
# WEBUI_CONFIG_PATH=storage/webui-config.json

# MCP shares the WebUI listener; separate read/write tokens generated in storage/
MCP_ENABLED=true
# MCP_TOKEN=
# MCP_READ_TOKEN=
