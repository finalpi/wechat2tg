{
  "name": "wechat2tg",
  "version": "6.0.40-dev.2",
  "description": "simple kit send wechat message to telegram",
  "main": "app.ts",
  "esModuleInterop": true,
  "scripts": {
    "dev": "ts-node src/app.ts",
    "build": "tsc && tsc -p webui/tsconfig.json && vite build --config webui/vite.config.ts && node scripts/copy-webui.cjs",
    "check:version": "node scripts/check-version.cjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "webui": "node dist/webui/standalone.js",
    "test:webui": "npm run build && node --test test/webui.test.cjs",
    "start": "NODE_ENV=production node dist/app.js",
    "test:mcp": "npm run build && node --test test/mcp.test.cjs",
    "mcp": "node scripts/wechat-mcp.cjs",
    "build:webui": "tsc -p webui/tsconfig.json && vite build --config webui/vite.config.ts",
    "test:webui:browser": "npm run build && node scripts/test-webui-browser.cjs && node scripts/test-webui-config-browser.cjs && node scripts/test-mini-app-browser.cjs && node scripts/test-automation-browser.cjs",
    "dev:webui": "node scripts/dev-webui.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.9.0",
    "crypto": "^1.0.1",
    "dotenv": "^16.0.3",
    "entities": "2.2.0",
    "ffmpeg-static": "^5.2.0",
    "file-box": "^1.4.15",
    "fluent-ffmpeg": "^2.1.2",
    "htmlparser2": "6.1.0",
    "https-proxy-agent": "^6.2.1",
    "log4js": "^6.9.1",
    "mqtt": "^5.15.0",
    "qrcode": "^1.5.1",
    "quickjs-emscripten": "0.32.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.33.4",
    "socks-proxy-agent": "^6.2.1",
    "sqlite3": "^5.1.7",
    "telegraf": "^4.16.3",
    "telegram": "2.21.2",
    "tencentcloud-sdk-nodejs": "^4.0.977",
    "typeorm": "^0.3.24",
    "wx2tg-puppet": "6.0.17",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@shadcn/react": "^0.3.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^8.39.0",
    "eslint-config-xo": "^0.43.1",
    "eslint-config-xo-typescript": "^0.57.0",
    "js-yaml": "4.1.1",
    "lucide-react": "^1.69.0",
    "playwright-core": "1.56.1",
    "postcss": "^8.5.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.4",
    "vite": "^5.4.21"
  }
}
